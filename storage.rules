rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow read access to anyone (so the web app can stream the videos)
      allow read: if true;
      // Allow write access only for video files to prevent abuse
      allow write: if request.resource.contentType.matches('video/.*');
    }
  }
}
