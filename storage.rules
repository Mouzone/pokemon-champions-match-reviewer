rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow read access only to authenticated users (admin)
      allow read: if request.auth != null;
      // Allow write access only to authenticated users (admin) and ensure it's a video
      allow write: if request.auth != null && request.resource.contentType.matches('video/.*');
    }
  }
}
